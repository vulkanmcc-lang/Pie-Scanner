{
	"schemaVersion": 1,
	"id": "pie-scanner",
	"version": "${version}",
	"name": "Pie Scanner",
	"description": "An experimental client-side mod that analyzes Minecraft's debug profiler to estimate the location of entities and block entities.",
	"authors": [
		"Vulkan"
	],
	"license": "MIT",
	"icon": "assets/pie-scanner/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.piescanner.PieScannerClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
